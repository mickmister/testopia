{
  "name": "testopia",
  "private": true,
  "version": "0.1.0",
  "description": "Story-first, co-located tests across Vitest and Playwright",
  "type": "module",
  "bin": {
    "testopia": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "test:framework": "node src/cli.js test",
    "test:unit": "node src/cli.js test --type unit",
    "test:integration": "node src/cli.js test --type integration",
    "test:e2e": "node src/cli.js test --type e2e",
    "test:ci": "npm test && npm run test:framework"
  },
  "dependencies": {
    "@playwright/test": "^1.56.0",
    "magic-string": "^0.30.17",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
